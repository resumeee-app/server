# ==============================================================================
# Resumeee Environment Configuration (12-Factor Compliant)
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Invariant: Secrets and credentials are NEVER stored in SQLite or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server & Storage Configuration
# ------------------------------------------------------------------------------
# Port for the REST API HTTP server to listen on.
# Default: 8080
PORT=8080

# Path to the SQLite database file.
# Container volume path: /data/resumeee.db
# Local development default: ./data/resumeee.db (or :memory: for tests)
DB_PATH=./data/resumeee.db

# Runtime environment (development | production).
# In production, structured JSON logs (slog.NewJSONHandler) are emitted.
# In development, human-readable text logs (slog.NewTextHandler) are emitted.
ENV=development

# Minimum logging severity level (DEBUG | INFO | WARN | ERROR).
# Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Multi-Tenancy, Authentication & Local Admin Mode
# ------------------------------------------------------------------------------
# Active authentication provider (admin | firebase | custom).
# If omitted, defaults to 'admin' when ADMIN_MODE=true and 'firebase' when FIREBASE_PROJECT_ID is set.
# AUTH_PROVIDER=admin

# Run in local single-user Admin Mode across backend and frontend (bypasses Firebase
# token verification, automatically binds DEFAULT_USER_ID to request context, and
# attaches X-User-ID: default in the SPA when no Bearer token is set).
# Set ADMIN_MODE=true for local self-hosted single-user usage; set ADMIN_MODE=false for
# multi-tenant deployments backed by Firebase Authentication.
# Default: false (enabled as true here for local development convenience)
ADMIN_MODE=true

# Default User ID applied when ADMIN_MODE=true (local single-user mode).
# Default: default
DEFAULT_USER_ID=default

# Google Firebase Project ID used to verify Bearer ID tokens when ADMIN_MODE=false.
# Required when ADMIN_MODE=false.
FIREBASE_PROJECT_ID=

# Firebase Web API Key supplied to frontend at runtime via GET /api/v1/auth/config.
FIREBASE_API_KEY=

# Firebase Auth Domain supplied to frontend at runtime via GET /api/v1/auth/config.
# Defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com if omitted.
FIREBASE_AUTH_DOMAIN=

# ------------------------------------------------------------------------------
# 3. Tenant LLM Quota Limits
# ------------------------------------------------------------------------------
# Maximum number of LLM operations (tailoring, gap analysis, PDF parsing)
# allowed per tenant within a rolling 24-hour window.
# Default: 50
LLM_DAILY_REQUEST_LIMIT=50

# Maximum number of total LLM tokens (prompt + completion) allowed per tenant
# within a rolling 30-day window.
# Default: 1000000
LLM_MONTHLY_TOKEN_LIMIT=1000000

# ------------------------------------------------------------------------------
# 4. Asynchronous Generation Worker Pool
# ------------------------------------------------------------------------------
# Number of concurrent worker goroutines processing queued resume generation jobs.
# Default: 2
WORKER_CONCURRENCY=2

# Maximum concurrent in-flight worker jobs allowed per tenant (fair scheduling
# / noisy-neighbor protection).
# Default: 2
MAX_CONCURRENT_JOBS_PER_TENANT=2

# ------------------------------------------------------------------------------
# 5. Hosted LLM Providers (At least one provider required for AI resume generation)
# ------------------------------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API key (https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. Open-Weight / OpenAI-Compatible Inference (e.g. Ollama, vLLM, LM Studio)
# ------------------------------------------------------------------------------
# Base URL for OpenAI-compatible inference endpoint.
# When using Docker Compose with profile 'local-llm', use: http://ollama:11434/v1
# When running against host Ollama, use: http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1

# Authorization token for OpenAI-compatible endpoint (optional dummy token for Ollama).
OPENAI_COMPAT_API_KEY=ollama

# ------------------------------------------------------------------------------
# 7. Timeout Configuration
# ------------------------------------------------------------------------------
# Timeout budget for regular synchronous REST interactions (e.g. 20s, 30s).
# Governs REST API context deadlines and synchronous HTTP/MCP handler bounds.
# Default: 20s
REST_TIMEOUT=20s

# Timeout budget for generative LLM operations (e.g. 10m, 15m).
# Governs outbound LLM provider client requests, background tailoring, and MCP tailoring calls.
# Default: 10m
LLM_TIMEOUT=10m

# Timeout budget for upstream PDF resume extraction requests.
# Default: 10m
PDF_PARSE_TIMEOUT=10m

# Timeout budget for synchronous POST template/version preview rendering (exempt from REST_TIMEOUT).
# GET /api/v1/templates/{id}/preview remains bounded by REST_TIMEOUT.
# Default: 10s
RENDER_PREVIEW_TIMEOUT=10s

# HTTP server timeout waiting for request headers.
# Default: 5s
HTTP_READ_HEADER_TIMEOUT=5s

# HTTP server maximum duration for reading the entire request including body.
# Default: 60s
HTTP_READ_TIMEOUT=60s

# Minimum HTTP server write timeout regardless of REST_TIMEOUT.
# Default: 30s
HTTP_MIN_WRITE_TIMEOUT=30s

# Buffer added to REST_TIMEOUT when computing HTTP server write timeout.
# Default: 10s
HTTP_WRITE_TIMEOUT_BUFFER=10s

# HTTP server maximum idle keep-alive duration between requests.
# Default: 120s
HTTP_IDLE_TIMEOUT=120s

# Graceful HTTP server shutdown drain timeout.
# Default: 10s
HTTP_SHUTDOWN_TIMEOUT=10s

# Keep-alive heartbeat interval for MCP SSE streams.
# Default: 15s
MCP_SSE_KEEPALIVE_INTERVAL=15s

# ------------------------------------------------------------------------------
# 8. Web SPA Configuration (web/)
# ------------------------------------------------------------------------------
# Host port mapping for the Resumeee React Web SPA container in docker-compose.
# Default: 3000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 9. LLM Prompt & Response Debugging
# ------------------------------------------------------------------------------
# Persist all outbound LLM prompts and inbound responses as Markdown documents
# partitioned by tenant under <app_root>/data/llm/<tenant_id>/<operation>_<yyyymmddHHiiss>[_output].md.
# Can be enabled via LLM_DEBUG_PROMPTS or DEBUG_LLM_PROMPTS (or CLI flag -debug-llm-prompts).
# Default: false
LLM_DEBUG_PROMPTS=false
DEBUG_LLM_PROMPTS=false

# Directory where LLM prompt and response markdown debug files are stored.
# Can be configured via LLM_DEBUG_DIR or DEBUG_LLM_DIR (or CLI flag -llm-debug-dir / -debug-llm-dir).
# Default: data/llm
LLM_DEBUG_DIR=data/llm
DEBUG_LLM_DIR=data/llm
