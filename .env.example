# ==============================================================================
# Resumeee Environment Configuration (12-Factor Compliant)
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Invariant: Secrets and credentials are NEVER stored in SQLite or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server & Storage Configuration
# ------------------------------------------------------------------------------
# Port for the REST API HTTP server to listen on.
# Default: 8080
PORT=8080

# Path to the SQLite database file.
# Container volume path: /data/resumeee.db
# Local development default: ./data/resumeee.db (or :memory: for tests)
DB_PATH=./data/resumeee.db

# Default User ID for single-user self-hosted deployment.
# Default: default
DEFAULT_USER_ID=default

# Runtime environment (development | production).
# In production, structured JSON logs (slog.NewJSONHandler) are emitted.
# In development, human-readable text logs (slog.NewTextHandler) are emitted.
ENV=development

# Minimum logging severity level (DEBUG | INFO | WARN | ERROR).
# Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Asynchronous Generation Worker Pool
# ------------------------------------------------------------------------------
# Number of concurrent worker goroutines processing queued resume generation jobs.
# Default: 2
WORKER_CONCURRENCY=2

# Maximum in-memory queue buffer capacity before returning 503 QUEUE_FULL.
# Default: 100
WORKER_QUEUE_SIZE=100

# ------------------------------------------------------------------------------
# 3. Hosted LLM Providers (At least one provider required for AI resume generation)
# ------------------------------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API key (https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 4. Open-Weight / OpenAI-Compatible Inference (e.g. Ollama, vLLM, LM Studio)
# ------------------------------------------------------------------------------
# Base URL for OpenAI-compatible inference endpoint.
# When using Docker Compose with profile 'local-llm', use: http://ollama:11434/v1
# When running against host Ollama, use: http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1

# Authorization token for OpenAI-compatible endpoint (optional dummy token for Ollama).
OPENAI_COMPAT_API_KEY=ollama

# ------------------------------------------------------------------------------
# 5. Web UI Server Configuration (cmd/web)
# ------------------------------------------------------------------------------
# Port for the standalone Web UI HTTP server.
# Default: 3000
WEB_PORT=3000

# Target backend REST API URL that the Web UI communicates with.
# Container network default: http://server:8080/api/v1
# Local development default: http://localhost:8080/api/v1
API_URL=http://localhost:8080/api/v1

# Web UI environment (development | production).
# Default: development
RESUMEEE_WEB_ENV=development

# Web UI HTTP client timeout duration (e.g. 30s, 60s).
# Default: 60s
RESUMEEE_CLIENT_TIMEOUT=60s

# ------------------------------------------------------------------------------
# 6. LLM Prompt & Response Debugging (Issue #120)
# ------------------------------------------------------------------------------
# Persist all outbound LLM prompts and inbound responses as Markdown documents
# under <app_root>/data/llm/<operation>_<yyyymmddHHiiss>[_output].md.
# Can be enabled via LLM_DEBUG_PROMPTS or DEBUG_LLM_PROMPTS (or CLI flag -debug-llm-prompts).
# Default: false
LLM_DEBUG_PROMPTS=false
DEBUG_LLM_PROMPTS=false

# Directory where LLM prompt and response markdown debug files are stored.
# Can be configured via LLM_DEBUG_DIR or DEBUG_LLM_DIR (or CLI flag -llm-debug-dir / -debug-llm-dir).
# Default: data/llm
LLM_DEBUG_DIR=data/llm
DEBUG_LLM_DIR=data/llm

